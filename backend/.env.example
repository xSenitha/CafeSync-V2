PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cafesync?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
NODE_ENV=development

# Exact frontend origins allowed to call the API, separated by commas.
# Local development origins remain available. Do not use wildcard domains.
# Example: https://cafesync.vercel.app,https://cafe.example.com
CORS_ORIGINS=

# Optional: server-side AI. Leave blank to use the built-in menu/order guide.
# Never put this key in the mobile app or an EXPO_PUBLIC_ variable.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# To use a Google AI Studio key, set AI_PROVIDER=gemini and fill in this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
